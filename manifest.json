{
  "manifest_version": 3,
  "name": "DriftGuard",
  "version": "0.1.0",
  "description": "Catch browser drift before it becomes a lost hour.",
  "permissions": ["tabs", "storage", "idle", "alarms", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "incognito": "split",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "DriftGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
