# DriftGuard site: server-side environment variables.
# Copy to .env.local for local dev. On Vercel set them in Project → Settings → Environment Variables.
# None of these are NEXT_PUBLIC_*, so they never reach the browser bundle.

# Required for the AI check (POST /api/relevance). Without it the endpoint answers 503
# {"error":"not_configured"} and the extension silently falls back to its rules.
# Create one at https://openrouter.ai/keys (set a monthly credit limit on the key).
OPENROUTER_API_KEY=

# Optional. Primary vision model, then the fallback OpenRouter tries if the primary errors.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3.1-flash-lite

# Optional. Sent to OpenRouter as HTTP-Referer for attribution. Defaults to the Vercel
# production URL when deployed.
SITE_URL=
